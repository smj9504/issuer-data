# Copy to .env and fill in. All keys are optional — a missing key just skips that source.
# Env prefix is STOCK_ (pydantic-settings).

# DART / OpenDART (Korea) — free key from https://opendart.fss.or.kr
STOCK_DART_API_KEY=

# Financial Modeling Prep — free tier key from https://financialmodelingprep.com
STOCK_FMP_API_KEY=

# Alpha Vantage — free key from https://www.alphavantage.co/support/#api-key
STOCK_ALPHAVANTAGE_API_KEY=

# 국가법령정보 공동활용 OpenAPI (Korean statutes) — apply at https://open.law.go.kr
# (LSO > OpenAPI 신청). OC is the id-part of the email you registered with
# (e.g. "abcd" for abcd@korea.kr), not a generated key.
STOCK_LAW_API_OC=

# SEC EDGAR requires a descriptive User-Agent with contact info, or requests get 403.
STOCK_SEC_USER_AGENT=stock-data research your-email@example.com

# KRX member login (FREE, register at data.krx.co.kr) — enables pykrx's portal
# endpoints: KR foreign-ownership %, listed shares, and index membership.
# NOTE: use the UNPREFIXED names here — pykrx reads KRX_ID / KRX_PW straight from
# the environment, and Settings reads the same two names (STOCK_KRX_ID /
# STOCK_KRX_PW are still accepted as a fallback).
# Leave these COMMENTED OUT unless you actually have a login: pykrx logs in at
# import time and treats a blank value as a failed login rather than staying
# anonymous, so `KRX_ID=` is worse than no line at all. Uncomment to use KRX.
#KRX_ID=
#KRX_PW=

# PostgreSQL connection string. A host other than localhost gets
# sslmode=verify-full unless the DSN sets sslmode itself.
# Local test container:  postgresql://stock:stock@localhost:55432/stock_test
STOCK_DB_DSN=postgresql://user:password@host:5432/stock_data

# Directory for downloaded filing originals
STOCK_DOCS_DIR=data/documents

# Optional curated cross-listing overrides (CSV)
STOCK_OVERRIDES_PATH=data/company_overrides.csv

# --- Structured PDF extraction / paid escalation (all optional) ---------------
# The structured PDF engine (--extract-tables) runs locally and free. Escalation
# re-processes ONLY low-confidence tables through a paid LLM. It stays OFF and
# local-only by default; local_only=true hard-blocks any off-box call even when
# enabled, so documents never egress unless you explicitly opt in on BOTH flags.
STOCK_PDF_ESCALATION_ENABLED=false
STOCK_PDF_LOCAL_ONLY=true
STOCK_PDF_CONFIDENCE_THRESHOLD=0.66
STOCK_ESCALATION_API_KEY=
STOCK_ESCALATION_ENDPOINT=https://api.anthropic.com/v1/messages
STOCK_ESCALATION_MODEL=claude-sonnet-4-5
STOCK_ESCALATION_COST_PER_PAGE=0.02

# --- Local ML table detection (optional, free, off by default) ----------------
# Microsoft Table Transformer / IBM Docling, both MIT and run on-box: no API key
# and no per-page cost, but several GB of torch + weights and seconds per page.
# Needs `pip install '.[ml]'`; also toggled per run with --ml-tables/--ml-engine.
STOCK_PDF_ML_TABLES=false
STOCK_PDF_ML_ENGINE=table-transformer
STOCK_PDF_ML_DPI=150

# --- Extraction validation (reference-free; on by default) --------------------
# Every parsed PDF is checked against itself and given a verdict — pass / review
# / fail — so a bad parse leaves a record instead of a quietly empty result.
# Coverage is the share of the page's own content that survived into the output;
# below the floor the document is treated as failed rather than merely doubtful.
# These are starting points, not measurements: calibrate them against a labelled
# sample with `python -m stock_data eval` before trusting them.
STOCK_PDF_VALIDATE_ENABLED=true
STOCK_PDF_COVERAGE_MIN=0.98
STOCK_PDF_COVERAGE_FAIL=0.85
# Consensus between two independent detectors. Costs a second full parse, so it
# is off by default — use it for spot checks and sampling, not bulk backfills.
STOCK_PDF_AGREEMENT_ENABLED=false
STOCK_PDF_AGREEMENT_MIN=0.90
# Check a filing's figures against data collected from other sources. A local
# database query, so effectively free.
STOCK_PDF_CROSSCHECK_ENABLED=true
# Optional JSON schema of the fields a document must yield; without one the gate
# rests on coverage and arithmetic alone.
STOCK_PDF_FIELD_SCHEMA=

# --- OCR for scanned PDFs (on by default) -------------------------------------
# PDFs with no text layer are rendered and OCR'd, so an image-only filing is not
# stored empty. Needs the Tesseract binary: apt install tesseract-ocr
# tesseract-ocr-kor tesseract-ocr-chi-tra. Set false (or pass --no-ocr) to skip it.
STOCK_OCR_ENABLED=true
STOCK_OCR_LANGUAGES=eng+kor+chi_tra
STOCK_OCR_DPI=300
