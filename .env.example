# Copy to .env and fill in. All keys are optional — a missing key just skips that source.
# Env prefix is ISSUER_ (pydantic-settings).

# DART / OpenDART (Korea) — free key from https://opendart.fss.or.kr
ISSUER_DART_API_KEY=

# Financial Modeling Prep — free tier key from https://financialmodelingprep.com
ISSUER_FMP_API_KEY=

# Alpha Vantage — free key from https://www.alphavantage.co/support/#api-key
ISSUER_ALPHAVANTAGE_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with contact info, or requests get 403.
ISSUER_SEC_USER_AGENT=issuer-data research your-email@example.com

# SQLite database location (relative to CWD or absolute)
ISSUER_DB_PATH=data/issuer_data.sqlite

# Directory for downloaded filing originals
ISSUER_DOCS_DIR=data/documents

# Optional curated cross-listing overrides (CSV)
ISSUER_OVERRIDES_PATH=data/company_overrides.csv
